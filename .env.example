# CampusPilot AI Configuration
# Note: CampusPilot AI runs 100% locally out-of-the-box using deterministic rule-based simulation.
# Paid or external LLM API keys are OPTIONAL and NEVER required to run the app.

# Backend Port and Host
HOST=127.0.0.1
PORT=8000

# Optional LLM integration (OpenAI / Anthropic / Local Ollama)
LLM_PROVIDER=rule_based
# OPENAI_API_KEY=your_optional_openai_key_here
# ANTHROPIC_API_KEY=your_optional_anthropic_key_here
# OLLAMA_HOST=http://localhost:11434

# Persistence
DATABASE_PATH=campuspilot.db
